{
  "manifest_version": 3,
  "name": "Service Timer",
  "version": "1.0",
  "description": "Controle de tempo por tipo de serviço",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Service Timer",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://script.google.com/*"]
}
