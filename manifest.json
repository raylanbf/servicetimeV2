{
  "manifest_version": 3,
  "name": "Service Timer",
  "version": "2.1",
  "description": "Controle de tempo por tipo de serviço",
  "action": {
    "default_title": "Service Timer",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "contextMenus", "scripting", "downloads", "windows", "clipboardWrite", "sidePanel", "alarms"],
  "host_permissions": ["https://script.google.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["highlighter.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["test-clipboard.html", "test-clipboard.js", "manual.html", "manual.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
