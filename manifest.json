{
  "manifest_version": 3,
  "name": "Service Timer",
  "version": "3.12",
  "description": "Controle de tempo por tipo de serviço",
  "action": {
    "default_title": "Service Timer",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "contextMenus", "scripting", "downloads", "windows", "clipboardWrite", "clipboardRead", "offscreen", "sidePanel", "alarms"],
  "commands": {
    "justify-text": {
      "suggested_key": { "default": "Ctrl+Shift+J" },
      "description": "Justificar texto no editor (Canvas)"
    },
    "equation-editor": {
      "suggested_key": { "default": "Ctrl+Shift+Q" },
      "description": "Abrir o editor de equação LaTeX (Canvas)"
    }
  },
  "host_permissions": ["https://script.google.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["highlighter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["canvas-justify.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.instructure.com/courses/*", "https://canvas.pucminas.br/courses/*"],
      "js": ["canvas-course-type.js", "canvas-h5p-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*", "https://canvas.pucminas.br/courses/*"],
      "js": ["h5p-width.js", "canvas-h5p.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.h5p.com/lti/*"],
      "js": ["h5p-search.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["test-clipboard.html", "test-clipboard.js", "manual.html", "manual.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
